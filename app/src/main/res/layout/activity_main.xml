<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ── TOP: Title ── -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ Cleaner"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="36dp" />

    <!-- ── MIDDLE: Big % ── -->
    <TextView
        android:id="@+id/tvPercentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textSize="88sp"
        android:textStyle="bold"
        android:textColor="@color/green"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvStageLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="READY"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toBottomOf="@id/tvPercentage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap Clean to begin"
        android:textSize="13sp"
        android:textColor="@color/light_gray"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvStageLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="32dp"
        android:progress="0"
        android:max="100"
        android:progressTint="@color/green"
        android:progressBackgroundTint="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/tvProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── STATS ROW ── -->
    <LinearLayout
        android:id="@+id/statsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- MB Freed -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/card_bg_blue"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp" android:gravity="center">
                <TextView android:id="@+id/tvMbCleared"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0 MB" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="@color/blue_bright" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Freed" android:textSize="11sp" android:textColor="@color/blue_light" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Apps Cleaned -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp" android:gravity="center">
                <TextView android:id="@+id/tvAppsCleared"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="@color/green" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cleaned" android:textSize="11sp" android:textColor="@color/light_gray" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Apps Killed -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp" android:gravity="center">
                <TextView android:id="@+id/tvAppsKilled"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="@color/orange" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Closed" android:textSize="11sp" android:textColor="@color/light_gray" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- App count hint -->
    <TextView
        android:id="@+id/tvAppCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:textColor="@color/light_gray"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/statsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── BOTTOM: Accessibility + Clean button pinned ── -->
    <Button
        android:id="@+id/btnEnableAccessibility"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="Enable Accessibility"
        android:textSize="13sp"
        android:backgroundTint="@color/card_bg"
        android:textColor="@color/orange"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnClean"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/Widget.MaterialComponents.Button" />

    <Button
        android:id="@+id/btnClean"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="⚡  CLEAN NOW"
        android:textSize="20sp"
        android:textStyle="bold"
        android:backgroundTint="@color/green"
        android:textColor="@color/white"
        android:enabled="false"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/Widget.MaterialComponents.Button" />

    <!-- Status text just above accessibility button -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️ Enable Accessibility to begin"
        android:textSize="12sp"
        android:textColor="@color/orange"
        android:gravity="center"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/btnEnableAccessibility"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
